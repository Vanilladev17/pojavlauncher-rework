<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app"
    android:orientation="vertical"
    android:paddingHorizontal="10dp"
    android:paddingTop="8dp"
    android:paddingBottom="10dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/gamefiles_title"
        android:textColor="@color/primary_text"
        android:textSize="17sp"
        android:textStyle="bold" />

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:columnCount="4"
        android:rowCount="2">

        <Button android:id="@+id/game_files_jump_root" style="?android:attr/buttonStyleSmall" android:layout_width="0dp" android:layout_height="42dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:singleLine="true" android:textSize="11sp" android:text="@string/gamefiles_jump_root" />
        <Button android:id="@+id/game_files_jump_mods" style="?android:attr/buttonStyleSmall" android:layout_width="0dp" android:layout_height="42dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:singleLine="true" android:textSize="11sp" android:text="@string/gamefiles_jump_mods" />
        <Button android:id="@+id/game_files_jump_resourcepacks" style="?android:attr/buttonStyleSmall" android:layout_width="0dp" android:layout_height="42dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:singleLine="true" android:textSize="11sp" android:text="@string/gamefiles_jump_resourcepacks" />
        <Button android:id="@+id/game_files_jump_shaderpacks" style="?android:attr/buttonStyleSmall" android:layout_width="0dp" android:layout_height="42dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:singleLine="true" android:textSize="11sp" android:text="@string/gamefiles_jump_shaderpacks" />
        <Button android:id="@+id/game_files_jump_saves" style="?android:attr/buttonStyleSmall" android:layout_width="0dp" android:layout_height="42dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:singleLine="true" android:textSize="11sp" android:text="@string/gamefiles_jump_saves" />
        <Button android:id="@+id/game_files_jump_versions" style="?android:attr/buttonStyleSmall" android:layout_width="0dp" android:layout_height="42dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:singleLine="true" android:textSize="11sp" android:text="@string/gamefiles_jump_versions" />
        <Button android:id="@+id/game_files_jump_profile" style="?android:attr/buttonStyleSmall" android:layout_width="0dp" android:layout_height="42dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:singleLine="true" android:textSize="11sp" android:text="@string/gamefiles_jump_profile" />
        <Button android:id="@+id/game_files_jump_config" style="?android:attr/buttonStyleSmall" android:layout_width="0dp" android:layout_height="42dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:singleLine="true" android:textSize="11sp" android:text="@string/gamefiles_jump_config" />
    </GridLayout>

    <TextView
        android:id="@+id/game_files_current_path"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:singleLine="true"
        android:ellipsize="middle"
        android:text="."
        android:textSize="12sp"
        android:textColor="@color/primary_text" />

    <com.kdt.pickafile.FileListView
        android:id="@+id/game_files_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <com.kdt.mcgui.MineButton
            android:id="@+id/game_files_import_mod"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:singleLine="true"
            android:textSize="12sp"
            android:text="@string/gamefiles_import_mod" />

        <com.kdt.mcgui.MineButton
            android:id="@+id/game_files_import_pack"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:singleLine="true"
            android:textSize="12sp"
            android:text="@string/gamefiles_import_pack" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <com.kdt.mcgui.MineButton
            android:id="@+id/game_files_import_here"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:singleLine="true"
            android:textSize="12sp"
            android:text="@string/gamefiles_import_here" />

        <com.kdt.mcgui.MineButton
            android:id="@+id/game_files_create_folder"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:singleLine="true"
            android:textSize="12sp"
            android:text="@string/folder_fragment_create" />
    </LinearLayout>
</LinearLayout>
